// Locks in the dyn-vtable-as-typed-record render against the
// showcase binary. Three samples cover the interesting cases:
//
//   * `dyn_ref`     — `&dyn Greeter` for Point. Single-method trait.
//   * `dyn_box`     — `Box<dyn Greeter>` for Point. Different fat-
//                     pointer wrapper, same vtable.
//   * `multi_bound` — `Box<dyn Error + Send + Sync>` for ShowcaseErr.
//                     Exercises the trait-inheritance / auto-trait
//                     bound case. Auto traits (Send/Sync) contribute
//                     no vtable entries so the slot list should
//                     match plain `dyn Error`'s.
//
// Vtable addresses, fn-pointer addresses, and ASLR-dependent values
// are masked to `$regex` so the test is portable across PIE slides.

{ jsonrpc: "2.0", id: 1, method: "break.set", params: { at: "main.rs:159" } }
{ jsonrpc: "2.0", id: 2, method: "run" }

{ jsonrpc: "2.0", id: 3, method: "assert.var", params: { name: "dyn_ref",
expect: {
  items: [
    {
      name: "dyn_ref",
      type: "&dyn showcase::main::Greeter [→ showcase::main::Point]",
      value_text: {
        $regex: "^\\&dyn showcase::main::Greeter \\[→ showcase::main::Point\\] \\{\n  data: 0x[0-9a-fA-F]+ → Point \\{ x: 1, y: 2\\.5 \\},\n  vtable: 0x[0-9a-fA-F]+ \\{\n    drop: <no Drop impl>,\n    size: 16,\n    align: 8,\n    greet: → <showcase::main::Point as showcase::main::Greeter>::greet \\(main\\.rs:112\\),\n  \\},\n\\}$"
      }
    }
  ],
  total: 1,
  truncated: false
}
} }
{ jsonrpc: "2.0", id: 4, method: "assert.var", params: { name: "dyn_box",
expect: {
  items: [
    {
      name: "dyn_box",
      type: "alloc::boxed::Box<dyn showcase::main::Greeter, alloc::alloc::Global> [→ showcase::main::Point]",
      value_text: {
        $regex: "^alloc::boxed::Box<dyn showcase::main::Greeter, alloc::alloc::Global> \\[→ showcase::main::Point\\] \\{\n  data: 0x[0-9a-fA-F]+ → Point \\{ x: 0, y: 0 \\},\n  vtable: 0x[0-9a-fA-F]+ \\{\n    drop: <no Drop impl>,\n    size: 16,\n    align: 8,\n    greet: → <showcase::main::Point as showcase::main::Greeter>::greet \\(main\\.rs:112\\),\n  \\},\n\\}$"
      }
    }
  ],
  total: 1,
  truncated: false
}
} }
{ jsonrpc: "2.0", id: 5, method: "assert.var", params: { name: "multi_bound",
expect: {
  items: [
    {
      name: "multi_bound",
      type: "alloc::boxed::Box<(dyn core::error::Error), alloc::alloc::Global> [→ showcase::main::ShowcaseErr]",
      value_text: {
        $regex: "^alloc::boxed::Box<\\(dyn core::error::Error\\), alloc::alloc::Global> \\[→ showcase::main::ShowcaseErr\\] \\[\\+ Send \\+ Sync\\] \\{\n  data: 0x[0-9a-fA-F]+ → ShowcaseErr\\(\"boom\"\\),\n  vtable: 0x[0-9a-fA-F]+ \\{\n    drop: <no Drop impl>,\n    size: 16,\n    align: 8,\n    fmt: → <showcase::main::ShowcaseErr as core::fmt::Debug>::fmt \\(main\\.rs:125\\),\n    fmt: → <showcase::main::ShowcaseErr as core::fmt::Display>::fmt \\(main\\.rs:128\\),\n    source: → core::error::Error::source \\(error\\.rs:105\\),\n    type_id: → core::error::Error::type_id \\(error\\.rs:116\\),\n    description: → core::error::Error::description \\(error\\.rs:131\\),\n    cause: → core::error::Error::cause \\(error\\.rs:141\\),\n    provide: → core::error::Error::provide \\(error\\.rs:204\\),\n  \\},\n\\}$"
      }
    }
  ],
  total: 1,
  truncated: false
}
} }
