      value_text: {
        $regex: "^Pin<Box<dyn Future<Output=u32>, _>> \\[→ \\{\\{closure\\}\\}\\] \\{\n  data: 0x[0-9a-fA-F]+,\n  vtable: 0x[0-9a-fA-F]+ \\{\n    drop: → drop_in_place<\\{\\{closure\\}\\}> \\(mod\\.rs:799\\),\n    size: 1,\n    align: 1,\n    main: \\{\n      \\{\\{closure\\}\\}: → main::\\{\\{closure\\}\\} \\(main\\.rs:170\\),\n    \\},\n  \\},\n\\}$"
      }
    }
  ],
  total: 1,
  truncated: false
}
} }
