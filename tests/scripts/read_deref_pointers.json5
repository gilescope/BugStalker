{ method: "run" }

{ method: "assert.var", params: { expression: "*ref_a",       hint: "*&i32 → i32",
expect: {
  items: [{ name: "ref_a", type: "i32", value_text: "i32(2)" }],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { expression: "*ptr_a",       hint: "*const i32 → i32",
expect: {
