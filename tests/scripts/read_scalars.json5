// Migrated from tests/integration/test_variables.py::test_read_scalar_variables.
// Reads all rust scalar primitives at the bottom of vars::scalars().
// Bless: bs --test --bless tests/scripts/read_scalars.json5 ./examples/target/debug/vars

{ method: "break.set", params: { at: "vars.rs:30" } }
{ method: "run" }

{ method: "assert.var", params: { name: "int8",         hint: "i8",
expect: {
  items: [{ name: "int8", type: "i8", value_text: "i8(1)" }],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "int16",        hint: "i16",
expect: {
  items: [{ name: "int16", type: "i16", value_text: "i16(-1)" }],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "int32",        hint: "i32",
expect: {
  items: [{ name: "int32", type: "i32", value_text: "i32(2)" }],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "int64",        hint: "i64",
expect: {
  items: [{ name: "int64", type: "i64", value_text: "i64(-2)" }],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "int128",       hint: "i128",
