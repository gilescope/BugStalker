      value_text: "bool(false)"
    }
  ],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "char_ascii",   hint: "char ASCII",
expect: {
  items: [
    { name: "char_ascii", type: "char", value_text: "char(a)" }
  ],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "char_non_ascii", hint: "char non-ASCII",
expect: {
  items: [
    {
      name: "char_non_ascii",
      type: "char",
