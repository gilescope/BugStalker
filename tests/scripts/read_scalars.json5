{ method: "assert.var", params: { name: "boolean_true", hint: "bool=true",
expect: {
  items: [
    {
      name: "boolean_true",
      type: "bool",
      value_text: "bool(true)"
    }
  ],
  total: 1,
  truncated: false
}
} }
{ method: "assert.var", params: { name: "boolean_false",hint: "bool=false",
expect: {
